# Copy this file to .env and fill in your credentials.
# NEVER commit .env or real API tokens to version control.

# Optional: Ngrok authtoken for public tunneling (run_ngrok.js)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: Hugging Face write token for Spaces deployment (upload_to_hf.py)
HF_TOKEN=your_huggingface_write_token_here

# Optional: Server port (default: 8000)
PORT=8000
